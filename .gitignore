# Temporary PRIVATE handoff: deny root items unless they belong to source/docs.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/THIRD_PARTY.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/src/
!/src/**
!/tests/
!/tests/**
!/.github/
!/crates/
!/crates/**
!/vendor/
!/vendor/**
!/xtask/
!/xtask/**
!/assets/
!/assets/**
!/tools/
!/tools/**
!/docs/
!/docs/**
!/spec.toml
!/.spec/
!/.spec/**
**/.git/
/*/**/.spec/
**/.agents/
**/runtime/
**/target/
**/node_modules/
**/.cache/
**/__pycache__/
**/.env
**/.env.*
**/credentials.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.exe
**/*.pdb
**/*.dll
**/*.rlib
**/*.rmeta
**/*.rcgu.o
**/*.log
**/*.onnx
**/*.safetensors
**/*.gguf
**/*.pt
**/*.pth
!/docs/spec/**/runtime/
!/docs/spec/**/runtime/*.md

# Private design mockups, demo artwork and other non-public notes (kept locally, never committed).
/.spec.local/
