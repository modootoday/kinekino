!/SECURITY.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/src/
!/src/**
!/tests/
!/tests/**
!/.github/
!/crates/
!/crates/**
!/vendor/
!/vendor/**
!/xtask/
!/xtask/**
!/assets/
!/assets/**
!/tools/
!/tools/**
!/docs/
!/docs/**
!/spec.toml
!/.spec/
!/.spec/**
!/.agents/
!/.agents/**
**/.git/
/*/**/.spec/
/*/**/.agents/
# Dev-host values and operations notes for agent rules stay local.
/.agents/local/
**/runtime/
**/target/
**/node_modules/
**/.cache/
**/__pycache__/
**/.env
**/.env.*
**/credentials.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.exe
**/*.pdb
**/*.dll
**/*.rlib
**/*.rmeta
**/*.rcgu.o
