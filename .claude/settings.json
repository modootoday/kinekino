{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch origin:*)",
      "Bash(git switch:*)",
      "Bash(git rebase origin/main:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo xtask lint-structure:*)",
      "Bash(cargo xtask spec-check:*)",
      "Bash(cargo xtask deny-terms:*)",
      "Bash(spec context:*)",
      "Bash(spec show:*)",
      "Bash(spec check:*)",
      "Bash(playpilot mail:*)",
      "Bash(playpilot sync:*)",
      "Bash(playpilot history-check:*)",
      "Bash(playpilot render:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)"
    ],
    "deny": [
      "Bash(gh secret:*)",
      "Bash(gh release:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh api repos/modootoday/kinekino/rulesets:*)",
      "Bash(cargo publish:*)",
      "Bash(npm publish:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)",
      "Bash(git tag:*)",
      "Bash(git add .)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.cargo/credentials.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'R=e80e7a2c605849b2d3fa2aa126aa1004719dc40a; B=\"$(command -v playpilot || echo \"$HOME/.cargo/bin/playpilot\")\"; D=\"$(dirname \"$(dirname \"$B\")\")\"; if [ \"$(cat \"$D/share/playpilot.rev\" 2>/dev/null)\" != \"$R\" ]; then for c in cargo /root/.cargo/bin/cargo \"$HOME/.cargo/bin/cargo\"; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" install --force --locked --quiet --git https://github.com/modootoday/playpilot --rev \"$R\" --root \"$D\" playpilot >&2 && mkdir -p \"$D/share\" && echo \"$R\" > \"$D/share/playpilot.rev\" && break; done; fi; [ -x \"$B\" ] || { echo \"playpilot CLI is missing and could not be installed\" >&2; exit 2; }; PLAYPILOT_PROTECTED_BRANCHES=main exec \"$B\" guard'",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
