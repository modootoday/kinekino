{
 "version": 1,
 "layers": {
  "reveal": {
   "priority": 0,
   "channels": [
    "body.weights (reveal, blush)",
    "eyes.scale"
   ]
  },
  "body": {
   "priority": 1,
   "channels": [
    "root.scale",
    "root.translation",
    "root.rotation"
   ],
   "_doc": "root only (whole-body squash/stretch/lean/translation)."
  },
  "shape": {
   "priority": 1,
   "channels": [
    "crown.scale",
    "crown.translation",
    "crown.rotation",
    "base_L.scale",
    "base_L.translation",
    "base_L.rotation",
    "base_R.scale",
    "base_R.translation",
    "base_R.rotation"
   ],
   "_doc": "v7: body deformer bones (skin slot falloff, identity at rest). Separate slot so shape clips (loaf/knead/crouch/arch/wobble_hit) compose with root clips (breathe/purr/tremble)."
  },
  "ear_L": {
   "priority": 2,
   "channels": [
    "ear_L.rotation",
    "ear_L_tip.rotation",
    "ear_L.scale"
   ]
  },
  "ear_R": {
   "priority": 2,
   "channels": [
    "ear_R.rotation",
    "ear_R_tip.rotation",
    "ear_R.scale"
   ]
  },
  "tail": {
   "priority": 2,
   "channels": [
    "tail_0..3.rotation",
    "tail_0..3.scale"
   ]
  },
  "eye_L": {
   "priority": 3,
   "channels": [
    "eye_L.scale",
    "eye_L.rotation",
    "eye_L.translation",
    "eye_L.weights"
   ]
  },
  "eye_R": {
   "priority": 3,
   "channels": [
    "eye_R.scale",
    "eye_R.rotation",
    "eye_R.translation",
    "eye_R.weights"
   ]
  },
  "look": {
   "priority": 4,
   "channels": [
    "eye_L_look.translation",
    "eye_R_look.translation",
    "head.rotation"
   ],
   "additive": [
    "ear_L.rotation",
    "ear_R.rotation"
   ]
  },
  "camera": {
   "priority": 0,
   "channels": [
    "camera.zoom",
    "camera.fovDeg",
    "camera.yawDeg",
    "camera.focus"
   ],
   "runtimeOnly": true,
   "_doc": "v8: view motion (src/presets/camera.json, src/runtime/camera.js). Not a mascot node, not in the glb; never written by part clips."
  }
 },
 "defaults": {
  "fadeIn": 0.12,
  "fadeOut": 0.2
 },
 "rules": [
  "A channel belongs to exactly one layer; clips never write channels of another layer.",
  "Same layer: new clip cross-fades the previous one (fadeIn of the new = fadeOut of the old).",
  "Different layers are independent; evaluation order does not matter.",
  "Look writes its own nodes absolutely and adds ear offsets after clip evaluation (only additive channel).",
  "priority decides which request wins when two arrive for the same layer in the same frame (higher wins).",
  "v7: combo tracks are [layer, clip, at, opts?]; opts: weight, timeScale, loop, hold, repeat {every, jitter}, side \"random\" (layer/clip written with ?), bpmScale. Track layer \"combo\" nests a combo, \"look\" plays a looks preset. \"$var\" clips resolve from combo vars / call vars.",
  "v7: reveal mode \"full\" (default: reveal.show/hide) or \"eyes\" (reveal.eyes/hide_eyes; only eyes shown so reveal.pulse can flash the band).",
  "v7: combo.blend = cross-fade (s) when the combo takes over layers: 0.2 default (0.15-0.3), 0.05 for startle-type (startled, angry_puff)."
 ],
 "eyes": {
  "_doc": "SVG units. v5: ellipse r[2.8,5], gap 28. v6: 1.5x size, 75% gap. v6.1: capsule (stadium) - straight sides + semicircular caps; height = straight + 2*capRadius, width = 2*capRadius by default.",
  "centerY": 58,
  "gap": 21,
  "maxScale": 1.22,
  "shape": {
   "type": "capsule",
   "width": 8.4,
   "straight": 6.6,
   "capRadius": 4.2
  }
 },
 "look": {
  "_doc": "lookPose(g) with g in [-1,1]^2 (x right, y up). eyeRange in SVG units (elliptic clamp; v6.1 widened 3x2.2 -> 7x4.5, worst-case eye edge stays 10.7 SVG units inside the rim), head deg, ear deg additive.",
  "eyeRange": [
   7.0,
   4.5
  ],
